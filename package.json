{
  "name": "ai-ems",
  "version": "1.7.0",
  "private": true,
  "scripts": {
    "test": "node --test test/error-handling-testing.test.cjs test/functional-testing.test.cjs test/performance-testing.test.cjs",
    "test:system": "node test/system-evaluation-visual-report.cjs",
    "dev:h5": "env-cmd -f .env.development uni",
    "dev:h5:local": "uni",
    "lint": "npm run lint:eslint && npm run format:check",
    "lint:eslint": "eslint . --ext .js,.mjs,.cjs,.vue",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,vue,json,html,md,css,scss,less,yml,yaml}\"",
    "format": "prettier --write \"**/*.{js,mjs,cjs,vue,json,html,md,css,scss,less,yml,yaml}\"",
    "lint:fix": "npm run lint:eslint -- --fix && npm run format",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "dependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@dcloudio/uni-app": "3.0.0-alpha-5010120260522001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5010120260522001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5010120260522001",
    "cross-env": "^10.1.0",
    "env-cmd": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "vite": "^5.0.0",
    "vue-eslint-parser": "^10.4.0"
  }
}
